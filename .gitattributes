# Normalize text to LF everywhere
* text=auto eol=lf

*.go text eol=lf diff=golang
*.sh text eol=lf
*.py text eol=lf diff=python
*.md text eol=lf diff=markdown
*.toml text eol=lf
*.json text eol=lf

# Generated
go.sum linguist-generated=true
uv.lock linguist-generated=true

# Binary data
*.mp3 binary
*.m4a binary
*.wav binary
*.flac binary
*.f16 binary
*.f32 binary
*.sqlite binary
*.png binary
